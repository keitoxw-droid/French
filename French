-- Helper pour interpoler de manière ultra-fluide et lisse entre les couleurs (Espace HSV)
local function lerpColorHSV(c1, c2, alpha)
    local h1, s1, v1 = c1:ToHSV()
    local h2, s2, v2 = c2:ToHSV()
    
    -- Plus court chemin sur le cercle chromatique
    local diff = h2 - h1
    if diff > 0.5 then
        diff = diff - 1
    elseif diff < -0.5 then
        diff = diff + 1
    end
    local h = (h1 + diff * alpha) % 1
    local s = s1 + (s2 - s1) * alpha
    local v = v1 + (v2 - v1) * alpha
    return Color3.fromHSV(h, s, v)
end

local function getInterpolatedColor(mode, c1, c2, c3, tProgress)
    if mode == __BTR_DEC({130,177,168,168,228,150,165,173,170,166,171,179,228,236,150,131,134,237}, 196) then
        return Color3.fromHSV(tProgress % 1, 1, 1)
    elseif mode == __BTR_DEC({135,177,183,176,171,169,228,236,246,228,135,171,168,171,182,183,237}, 196) then
        -- Smooth step sinusoïdal pour un va-et-vient soyeux
        local rawSin = math.sin(tProgress * math.pi * 2)
        local alpha = 0.5 + 0.5 * rawSin
        return lerpColorHSV(c1, c2, alpha)
    elseif mode == __BTR_DEC({135,177,183,176,171,169,228,236,247,228,135,171,168,171,182,183,237}, 196) then
        -- Transition douce et continue en 3 temps
        local p = (tProgress % 1) * 3
        if p < 1 then
            -- Courbe ease-in-out cosine
            local alpha = (1 - math.cos(p * math.pi)) / 2
            return lerpColorHSV(c1, c2, alpha)
        elseif p < 2 then
            local alpha = (1 - math.cos((p - 1) * math.pi)) / 2
            return lerpColorHSV(c2, c3, alpha)
        else
            local alpha = (1 - math.cos((p - 2) * math.pi)) / 2
            return lerpColorHSV(c3, c1, alpha)
        end
    end
    return Color3.fromHSV(tProgress % 1, 1, 1)
end

