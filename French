                    elseif obj:IsA(__BTR_DEC({128,161,167,165,168}, 196)) or obj:IsA(__BTR_DEC({144,161,188,176,177,182,161}, 196)) then
                        _savedGraphics.Parts[obj] = { Transparency = obj.Transparency }
                        obj.Transparency = 0.8
                    elseif obj:IsA(__BTR_DEC({148,165,182,176,173,167,168,161,129,169,173,176,176,161,182}, 196)) or obj:IsA(__BTR_DEC({144,182,165,173,168}, 196)) or obj:IsA(__BTR_DEC({151,169,171,175,161}, 196)) or obj:IsA(__BTR_DEC({130,173,182,161}, 196)) then
                        _savedGraphics.Parts[obj] = { Enabled = obj.Enabled }
                        obj.Enabled = false
                    end
                end)
            end
        else
            -- Restauration complète des graphismes
            pcall(function()
                if _savedGraphics.GlobalShadows ~= nil then Lighting.GlobalShadows = _savedGraphics.GlobalShadows end
                if _savedGraphics.FogEnd ~= nil then Lighting.FogEnd = _savedGraphics.FogEnd end
                if _savedGraphics.Brightness ~= nil then Lighting.Brightness = _savedGraphics.Brightness end
                if Terrain and _savedGraphics.TerrainWaterWaveSize ~= nil then Terrain.WaterWaveSize = _savedGraphics.TerrainWaterWaveSize end
            end)

            for obj, props in pairs(_savedGraphics.Parts or {}) do
                pcall(function()
                    if obj and obj.Parent then
                        if props.Material ~= nil then obj.Material = props.Material end
                        if props.CastShadow ~= nil then obj.CastShadow = props.CastShadow end
                        if props.Transparency ~= nil then obj.Transparency = props.Transparency end
                        if props.Enabled ~= nil then obj.Enabled = props.Enabled end
                    end
                end)
            end
            _savedGraphics = {}
        end
    end
})

