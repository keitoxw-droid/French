    local function getPartAnimDelta(bpKey, animTime, currentVelocity, rideState)
        local walkSpeed = math.min(currentVelocity / 50, 2)
        local walkPhase = animTime * (6 + walkSpeed * 4)
        local idlePhase = animTime * 2.5

        if bpKey:sub(1,5) == __BTR_DEC({180,165,176,176,161}, 196) then
            local isFront = bpKey:find(__BTR_DEC({165,178}, 196)) ~= nil
            local isMid   = bpKey:find(__BTR_DEC({169,173,168}, 196)) ~= nil
            local isLeft  = bpKey:find(__BTR_DEC({131}, 196)) ~= nil

            if rideState == __BTR_DEC({169,165,170,177,165,168,155,162,168,173,163,172,176}, 196) then
                local foldAngle = math.rad(-25) + math.sin(animTime * 2) * math.rad(3)
                return CFrame.Angles(foldAngle, 0, 0)
            else
                local phaseShift = 0
                if isFront then phaseShift = isLeft and 0 or math.pi
                elseif isMid then phaseShift = isLeft and math.pi or 0
                else phaseShift = isLeft and 0 or math.pi end
                local swing = math.sin(walkPhase + phaseShift) * (0.15 + walkSpeed * 0.25)
                local lift  = math.max(0, math.cos(walkPhase + phaseShift)) * (0.2 + walkSpeed * 0.3)
                return CFrame.new(0, lift, 0) * CFrame.Angles(swing, 0, 0)
            end
        elseif bpKey:sub(1,7) == __BTR_DEC({171,182,161,173,168,168,161}, 196) then
            local isLeft = bpKey:find(__BTR_DEC({131}, 196)) ~= nil
            local flapFreq = (rideState == __BTR_DEC({169,165,170,177,165,168,155,162,168,173,163,172,176}, 196)) and 5 or 2.5
            local flapAmp  = (rideState == __BTR_DEC({169,165,170,177,165,168,155,162,168,173,163,172,176}, 196)) and math.rad(22) or math.rad(8)
            local flap = math.sin(animTime * flapFreq) * flapAmp
            local dir = isLeft and -1 or 1
            return CFrame.Angles(0, 0, flap * dir)
        elseif bpKey:sub(1,6) == __BTR_DEC({176,182,171,169,180,161}, 196) then
            local isTip = bpKey:find(__BTR_DEC({246}, 196)) ~= nil
            local wave  = math.sin(idlePhase + (isTip and 1.5 or 0)) * math.rad(10)
            return CFrame.Angles(wave, 0, 0)
        elseif bpKey == __BTR_DEC({176,161,176,161}, 196) or bpKey == __BTR_DEC({167,171,177}, 196) then
            local breathe = math.sin(idlePhase) * 0.08
            return CFrame.new(0, breathe, 0) * CFrame.Angles(breathe * 0.5, 0, 0)
        end
        return CFrame.new(0, math.sin(idlePhase) * 0.05, 0)
    end

