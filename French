    local function startRobotLoop()
        if robotLoop then robotLoop:Disconnect() end
        local lastUpdate = 0
        robotAnimT = 0
        robotRisingProgress = 0

        robotLoop = game:GetService(__BTR_DEC({150,177,170,151,161,182,178,173,167,161}, 196)).Heartbeat:Connect(function(dt)
            if not robotActive then return end
            robotAnimT = robotAnimT + dt
            robotStateTimer = robotStateTimer + dt

            -- UPDATE POSITION SELON LE MODE
            if robotState == __BTR_DEC({165,176,176,165,167,175}, 196) then
                local fwd = Vector3.new(math.sin(robotAngle), 0, math.cos(robotAngle))
                robotAnchor = robotAnchor + fwd * 45 * dt

                if robotTarget then
                    local targetChar = workspace:FindFirstChild(robotTarget)
                    if targetChar and targetChar:FindFirstChild(__BTR_DEC({140,177,169,165,170,171,173,160,150,171,171,176,148,165,182,176}, 196)) then
                        local dir = (targetChar.HumanoidRootPart.Position - robotAnchor)
                        dir = Vector3.new(dir.X, 0, dir.Z)
                        if dir.Magnitude > 0 then
                            local targetAngle = math.atan2(dir.X, dir.Z)
                            local angleDiff = (targetAngle - robotAngle + math.pi) % (2 * math.pi) - math.pi
                            robotAngle = robotAngle + math.clamp(angleDiff, -5, 5) * dt
                        end
                    end
                end

            elseif robotState == __BTR_DEC({179,165,168,175}, 196) then
                if robotMode ~= __BTR_DEC({162,171,168,168,171,179}, 196) and robotMode ~= __BTR_DEC({162,182,161,161}, 196) then
                    local fwd = Vector3.new(math.sin(robotAngle), 0, math.cos(robotAngle))
                    robotAnchor = robotAnchor + fwd * robotSpeed * dt
                end

                if robotMode == __BTR_DEC({162,171,168,168,171,179}, 196) and robotFollowName ~= "" then
                    local tp = game:GetService(__BTR_DEC({148,168,165,189,161,182,183}, 196)):FindFirstChild(robotFollowName)
                    local hrp = tp and tp.Character and tp.Character:FindFirstChild(__BTR_DEC({140,177,169,165,170,171,173,160,150,171,171,176,148,165,182,176}, 196))
                    if hrp then
                        local toTarget = hrp.Position - robotAnchor
                        toTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
                        if toTarget.Magnitude > 6 then
                            local targetAngle = math.atan2(toTarget.X, toTarget.Z)
                            local angleDiff = targetAngle - robotAngle
                            while angleDiff >  math.pi do angleDiff = angleDiff - 2*math.pi end
                            while angleDiff < -math.pi do angleDiff = angleDiff + 2*math.pi end
                            robotAngle = robotAngle + math.clamp(angleDiff, -2.5, 2.5) * dt
                            local dist = toTarget.Magnitude
                            local adaptSpeed = math.clamp(dist * 0.6, robotSpeed, 55)
                            local fwdF = Vector3.new(math.sin(robotAngle), 0, math.cos(robotAngle))
                            robotAnchor = robotAnchor + fwdF * adaptSpeed * dt
                        else
                            robotState = __BTR_DEC({173,160,168,161}, 196)
                        end
                    end

                elseif robotMode == __BTR_DEC({162,182,161,161}, 196) then
                    if not robotWaypoint then
                        local rAngle = math.random() * 2 * math.pi
                        local rDist  = math.random(40, 120)
                        local nx = math.clamp(robotAnchor.X + math.cos(rAngle) * rDist, -350, 350)
                        local nz = math.clamp(robotAnchor.Z + math.sin(rAngle) * rDist, -350, 350)
                        robotWaypoint = Vector3.new(nx, robotAnchor.Y, nz)
                    end

                    local toWp = robotWaypoint - robotAnchor
                    toWp = Vector3.new(toWp.X, 0, toWp.Z)

                    if toWp.Magnitude < 8 then
                        robotWaypoint = nil
                        robotState    = __BTR_DEC({173,160,168,161}, 196)
                        if math.random() < 0.3 and canDo(__BTR_DEC({182,171,165,182,155,162,182,161,161}, 196), 15) then
                            task.delay(0.5, function()
                                if robotActive and robotMode == __BTR_DEC({162,182,161,161}, 196) and robotState == __BTR_DEC({173,160,168,161}, 196) then
                                    robotState = __BTR_DEC({182,171,165,182}, 196)
                                    robotStateTimer = 0
                                end
                            end)
                        end
                        task.delay(math.random(2, 7), function()
                            if not robotActive or robotMode ~= __BTR_DEC({162,182,161,161}, 196) then return end
                            if math.random() < 0.4 then
                                local closestHrp, closestD = nil, 250
                                for _, p in pairs(game:GetService(__BTR_DEC({148,168,165,189,161,182,183}, 196)):GetPlayers()) do
                                    local hrp = p.Character and p.Character:FindFirstChild(__BTR_DEC({140,177,169,165,170,171,173,160,150,171,171,176,148,165,182,176}, 196))
                                    if hrp then
                                        local d = (hrp.Position - robotAnchor).Magnitude
                                        if d < closestD then closestD = d; closestHrp = hrp end
                                    end
                                end
                                if closestHrp then
                                    robotWaypoint = Vector3.new(closestHrp.Position.X, robotAnchor.Y, closestHrp.Position.Z)
                                end
                            end
                            if robotState == __BTR_DEC({173,160,168,161}, 196) then robotState = __BTR_DEC({179,165,168,175}, 196) end
                        end)
                    else
                        local targetAngle = math.atan2(toWp.X, toWp.Z)
                        local angleDiff = targetAngle - robotAngle
                        while angleDiff >  math.pi do angleDiff = angleDiff - 2*math.pi end
                        while angleDiff < -math.pi do angleDiff = angleDiff + 2*math.pi end

                        local turnRate = math.clamp(math.abs(angleDiff) * 3, 1.5, 4.5)
                        robotAngle = robotAngle + math.clamp(angleDiff, -turnRate, turnRate) * dt
                        local alignRatio = 1 - math.min(math.abs(angleDiff) / math.pi, 1) * 0.75
                        robotAnchor = robotAnchor + Vector3.new(math.sin(robotAngle), 0, math.cos(robotAngle)) * (robotSpeed * alignRatio) * dt
                    end
                end
            end

            -- PROGRESSION ÉMERGENCE
            if robotState == __BTR_DEC({182,173,183,173,170,163}, 196) then
                robotRisingProgress = math.min(robotRisingProgress + dt * 0.22, 1)
                if robotRisingProgress >= 1 then
                    robotState = __BTR_DEC({173,160,168,161}, 196)
                    robotStateTimer = 0
                    rNotif(__BTR_DEC({137,129,135,140,133,228,150,139,134,139,144}, 196), __BTR_DEC({137,129,135,140,133,228,150,139,134,139,144,228,139,138,136,141,138,129,229}, 196), 5)
                end
            end

            -- AUTO-RETOUR EN IDLE
            if robotState == __BTR_DEC({165,176,176,165,167,175}, 196) and robotStateTimer > 3 then
                robotState = __BTR_DEC({173,160,168,161}, 196) robotStateTimer = 0
            end
            if robotState == __BTR_DEC({183,176,171,169,180}, 196) and robotStateTimer > 2.5 then
                robotState = __BTR_DEC({173,160,168,161}, 196) robotStateTimer = 0
            end
            if robotState == __BTR_DEC({182,171,165,182}, 196) and robotStateTimer > 5 then
                robotState = __BTR_DEC({173,160,168,161}, 196) robotStateTimer = 0
            end

            -- GESTION GRAVITÉ
            local rayOrigin = Vector3.new(robotAnchor.X, robotAnchor.Y + 200, robotAnchor.Z)
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {
                game:GetService(__BTR_DEC({148,168,165,189,161,182,183}, 196)).LocalPlayer.Character,
                workspace:FindFirstChild(__BTR_DEC({147,171,182,175,183,180,165,167,161,135,171,169}, 196))
            }
            local rayResult = workspace:Raycast(rayOrigin, Vector3.new(0, -500, 0), rayParams)
            if rayResult then
                local targetY = rayResult.Position.Y
                robotAnchor = Vector3.new(robotAnchor.X, robotAnchor.Y + (targetY - robotAnchor.Y) * math.clamp(dt * 8, 0, 1), robotAnchor.Z)
            end

            -- ENVOI DES CFRAMES (25 FPS)
            if tick() - lastUpdate < 0.04 then return end
            lastUpdate = tick()

            -- GESTION COULEUR
            local _ct = robotAnimT
            local pulse = (math.sin(_ct * 5) + 1) / 2
            local propColor

            if robotColorMode == __BTR_DEC({137,161,167,172,165,228,134,168,177,161}, 196) then
                local bR = 0.1 + pulse * 0.2
                local bG = 0.5 + pulse * 0.3
                local bB = 1.0
                propColor = Color3.new(bR, bG, bB)
            elseif robotColorMode == __BTR_DEC({151,172,165,160,171,179,228,133,182,173,183,161,228,236,146,173,171,168,161,176,237}, 196) then
                propColor = Color3.new(0.5 + pulse * 0.4, 0.05 + pulse * 0.1, 0.95 + pulse * 0.05)
            elseif robotColorMode == __BTR_DEC({137,165,163,169,165,228,150,161,160}, 196) then
                propColor = Color3.new(pulse * 0.8 + 0.2, 0, 0)
            elseif robotColorMode == __BTR_DEC({151,165,167,182,173,162,173,167,173,165,168,228,131,171,168,160}, 196) then
                propColor = Color3.new(0.8 + pulse * 0.2, 0.6 + pulse * 0.3, 0.1)
            elseif robotColorMode == __BTR_DEC({150,165,173,170,166,171,179}, 196) then
                propColor = Color3.fromHSV((_ct * 0.15) % 1, 1, 1)
            elseif robotColorMode == __BTR_DEC({148,168,165,183,169,165,228,147,165,178,161}, 196) then
                propColor = Color3.fromHSV((_ct * 0.25) % 1, 0.9, 1)
            else
                propColor = Color3.fromRGB(0, 160, 255)
            end

            local beamColor = Color3.fromRGB(220, 100, 255)

            for partIndex, layout in ipairs(ROBOT_LAYOUT) do
                local pData = robotScf[layout.key]
                if pData and pData.scf then
                    local cf = getPartCFrame(layout, robotAnimT, robotState, robotRisingProgress, partIndex)
                    local activeColor = layout.key:find(__BTR_DEC({166,161,165,169}, 196)) and beamColor or propColor
                    task.spawn(function()
                        pcall(function() pData.scf:InvokeServer(cf) end)
                        if pData.cpc then
                            pcall(function() pData.cpc:InvokeServer(activeColor) end)
                        end
