            local char = lp.Character
            local hrp = char and char:FindFirstChild(__BTR_DEC({140,177,169,165,170,171,173,160,150,171,171,176,148,165,182,176}, 196))
            local originalCF = hrp and hrp.CFrame

            _G.withAntiSitDisabled(function()
                while CanoeSpamActive do
                    char = lp.Character
                    hrp = char and char:FindFirstChild(__BTR_DEC({140,177,169,165,170,171,173,160,150,171,171,176,148,165,182,176}, 196))
                    local hum = char and char:FindFirstChildOfClass(__BTR_DEC({140,177,169,165,170,171,173,160}, 196))

                    if hrp and buttonPart then
                        -- 1) TP sur le bouton + Clic
                        pcall(function() hrp.CFrame = buttonPart.CFrame end)
                        task.wait(0.1)
                        pcall(function() fireclickdetector(detector, 0) end)
                        pcall(function() fireclickdetector(detector) end)
                    end

                    -- [INTERVAL 0.5s] Attente post-clic pour le spawn
                    task.wait(0.5)

                    -- 2) Détection du Canoë, TP sur VehicleSeat et déplacement au Spawn
                    if storage then
                        for _, canoe in ipairs(storage:GetChildren()) do
                            if canoe:IsA(__BTR_DEC({137,171,160,161,168}, 196)) and not canoe:GetAttribute(__BTR_DEC({134,144,150,151,180,182,161,165,160}, 196)) then
                                pcall(function() canoe:SetAttribute(__BTR_DEC({134,144,150,151,180,182,161,165,160}, 196), true) end)

                                local seat = canoe:FindFirstChildOfClass(__BTR_DEC({146,161,172,173,167,168,161,151,161,165,176}, 196)) 
                                          or canoe:FindFirstChildOfClass(__BTR_DEC({151,161,165,176}, 196)) 
                                          or canoe:FindFirstChild(__BTR_DEC({146,161,172,173,167,168,161,151,161,165,176}, 196))
                                          or canoe:FindFirstChild(__BTR_DEC({140,177,168,168}, 196))
                                          or canoe:FindFirstChildWhichIsA(__BTR_DEC({134,165,183,161,148,165,182,176}, 196))

                                if seat and hrp and hum then
                                    if not canoe.PrimaryPart then
                                        pcall(function() canoe.PrimaryPart = seat end)
                                    end

                                    -- 3) TP sur le siège + Sit
