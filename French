    _G.VehicleFlingActive = false
    _G.VehicleFlingCar = nil

    local function isOurFlingVehicle(item)
        -- Name-based: vehicles spawned via PickingCar are named __BTR_DEC({248,148,168,165,189,161,182,138,165,169,161,250,135,165,182}, 196)
        if _G.VehicleFlingActive and item.Name == LocalPlayer.Name .. __BTR_DEC({135,165,182}, 196) then
