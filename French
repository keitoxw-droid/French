                                    task.wait(0.05)
                                    
                                    for _ = 1, 6 do
                                        pcall(function() hrp.CFrame = seat.CFrame * CFrame.new(0, 1.5, 0) end)
                                        task.wait(0.05)
                                        if seat:IsA(__BTR_DEC({151,161,165,176}, 196)) or seat:IsA(__BTR_DEC({146,161,172,173,167,168,161,151,161,165,176}, 196)) then
                                            pcall(function() seat:Sit(hum) end)
                                        end
                                        if hum.Sit then break end
                                    end

                                    -- [INTERVAL 0.5s] Pause assise (Network Ownership)
                                    task.wait(0.5)

                                    if hum.Sit then
                                        -- 4) Déplacement du Canoë au Spawn (position aléatoire)
                                        local angle = math.random() * math.pi * 2
                                        local radius = math.random(5, 35)
                                        local destX = -16 + math.cos(angle) * radius
                                        local destZ = -47 + math.sin(angle) * radius
                                        local destCF = CFrame.new(destX, 4, destZ)

                                        pcall(function()
                                            if canoe.PrimaryPart then
                                                canoe:SetPrimaryPartCFrame(destCF)
                                            else
                                                canoe:PivotTo(destCF)
                                            end
                                        end)

                                        -- [INTERVAL 0.5s] Pause après le TP du véhicule
                                        task.wait(0.5)

                                        -- 5) Saut forcé et éjection du siège (méthode physique garantie)
                                        pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
                                        pcall(function() hum.Sit = false end)
                                        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                                        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                                        pcall(function() hum.Jump = true end)
                                        if hrp then
                                            pcall(function()
                                                hrp.AssemblyLinearVelocity = Vector3.new(0, 70, 0)
                                                hrp.Velocity = Vector3.new(0, 70, 0)
                                            end)
                                        end
                                        task.wait(0.1)
                                        pcall(function() hum.Jump = false end)

                                        -- [INTERVAL 0.5s] Pause après être debout
                                        task.wait(0.5)
                                    end
                                end
                            end
                        end
                    end
                end

                -- Restaure la position initiale au stop
                char = lp.Character
                hrp = char and char:FindFirstChild(__BTR_DEC({140,177,169,165,170,171,173,160,150,171,171,176,148,165,182,176}, 196))
                if hrp and originalCF then
                    pcall(function() hrp.CFrame = originalCF end)
                end
            end)
        end)
    end
    local function stopCanoeSpam()
