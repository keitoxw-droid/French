-- [INTEGRATION HUB v2 - 60FPS] Montures + Build + Attractions
-- (Licorne Geante, Vuivre Noire, AK-47, Attractions RGB)
-- Optimisation : PropStreamer v2 (calc 60fps / envoi smart ~15Hz)
-- ============================================================

-- ============================================================
-- [PROP STREAMER v2] 60 FPS CALC / SMART SEND
-- Le CFrame de chaque prop est CALCULE a 60fps (RenderStepped),
-- mais l'ENVOI reseau est limite a ~15Hz/prop avec latest-wins.
-- Delta threshold : si le prop bouge de moins de 0.75 stud,
-- on n'envoie RIEN (prop au repos = 0 requete/s).
-- vs le hub : 24fps calc + 300 req/s => ici 60fps + ~10x moins.
-- ============================================================
local PropStreamer = {}
PropStreamer.__index = PropStreamer

function PropStreamer.new(rate, deltaThreshold)
    return setmetatable({
        slots = {},
        rate = rate or 0.066,           -- 15Hz/prop max (225 req/s pour 15 props)
        deltaThreshold = deltaThreshold or 0.75, -- studs de deplacement minimum
        running = false,
        conn = nil,
    }, PropStreamer)
end

function PropStreamer:add(scf, cpc)
    if scf and not self.slots[scf] then
        self.slots[scf] = {
            cf = nil, color = nil,
            dirtyCF = false, dirtyColor = false,
            lastCF = nil, lastSent = 0,
            cpc = cpc,
        }
    end
end

function PropStreamer:setCF(scf, cf)
    local s = self.slots[scf]
    if s then
        s.cf = cf
        local now = tick()
        local moved = (not s.lastCF) or (s.lastCF.Position - cf.Position).Magnitude > self.deltaThreshold
        -- dirty si bouge reellement OU heartbeat 0.25s (le serveur garde le prop vivant)
        s.dirtyCF = s.dirtyCF or moved or (now - s.lastSent > 0.25)
    end
end

function PropStreamer:setColor(scf, color)
    local s = self.slots[scf]
    if s and s.cpc then
        s.color = color
        s.dirtyColor = true
    end
end

function PropStreamer:start()
    if self.running then return end
    self.running = true
    local rs = game:GetService(__BTR_DEC({150,177,170,151,161,182,178,173,167,161}, 196))
    self.conn = rs.RenderStepped:Connect(function()
        if not self.running then
            if self.conn then self.conn:Disconnect() self.conn = nil end
            return
        end
        local now = tick()
        for scf, s in pairs(self.slots) do
            if (s.dirtyCF or s.dirtyColor) and (now - s.lastSent >= self.rate) then
                s.lastSent = now
                if s.dirtyCF and s.cf then
                    s.dirtyCF = false
                    local cf = s.cf
                    task.spawn(function() pcall(function() scf:InvokeServer(cf) end) end)
                end
                if s.dirtyColor and s.color and s.cpc then
                    s.dirtyColor = false
                    local c = s.color
                    local cpc = s.cpc
                    task.spawn(function() pcall(function() cpc:InvokeServer(c) end) end)
                end
            end
        end
    end)
end

function PropStreamer:stop()
    self.running = false
    self.slots = {}
end


